# VideoSDK credentials (required) — get from https://app.videosdk.live
VIDEOSDK_API_KEY=""
VIDEOSDK_SECRET_KEY=""

# Upstream API base URL
VIDEOSDK_API_ENDPOINT="https://api.videosdk.live"

# Default region passed to VideoSDK when client omits it
VIDEOSDK_DEFAULT_REGION="sg001"

# JWT settings
TOKEN_TTL_SECONDS="600"
TOKEN_PERMISSIONS="allow_join,allow_mod"

# HTTP server
NODE_ENV="development"
HOST="0.0.0.0"
PORT="9000"

# Outbound HTTP (to VideoSDK)
HTTP_TIMEOUT_MS="10000"
HTTP_RETRY_ATTEMPTS="3"

# Rate limiting (per IP, applied to all routes)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"

# CORS — comma-separated list; "*" only allowed in development
CORS_ORIGINS="*"

# Logging
LOG_LEVEL="info"

# Graceful shutdown drain period
SHUTDOWN_TIMEOUT_MS="10000"

# Bootstrap: create a meeting + expose token at GET / when the server starts.
# Set to "false" to disable (e.g. in production) — clients must then call
# /get-token and /create-meeting explicitly.
BOOTSTRAP_MEETING_ON_START="true"
